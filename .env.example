# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Flutterwave v3 (Standard hosted checkout) ----------------------------
# Dashboard → Settings → API Keys.
#
# v3 (not v4) because it offers hosted checkout: the payment page is on
# Flutterwave's own domain, so card details never reach this app. See README.
#
# This is the ONLY payment key needed. Standard creates the payment link
# server-side, so nothing payment-related ships to the browser.
# Server-only — never prefix with NEXT_PUBLIC_.
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X

# Not needed for Standard. Only for the Inline modal, and only if you switch
# back to it: NEXT_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxx-X
# Not needed at all unless you charge cards directly (this build doesn't):
# FLW_ENCRYPTION_KEY=

# --- Email (Resend) -------------------------------------------------------
# https://resend.com/api-keys. Without these the receipt email is skipped and
# the full analysis is still shown on the receipt page.
RESEND_API_KEY=
# Must be on a domain verified in Resend, or sends will be rejected.
EMAIL_FROM=Nepo Detector <receipts@yourdomain.com>
EMAIL_REPLY_TO=

# --- Misc -----------------------------------------------------------------
# Public origin, used to build absolute og:image URLs for link previews.
# Falls back to the Vercel deployment host, then https://nepodetector.ng.
NEXT_PUBLIC_SITE_URL=

# Optional: powers the AI roast line. Without it, pre-written roasts are used.
GROQ_API_KEY=
