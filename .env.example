# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Flutterwave v4 ("Next Gen") — dashboard → Settings → API Keys.
# v4 uses OAuth 2.0 client credentials, not v3's static secret key.
# All three are SERVER-ONLY. Never prefix any of them with NEXT_PUBLIC_,
# or they get inlined into the browser bundle.
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
# Base64 AES-256 key, used to encrypt card fields before they hit /payment-methods.
FLW_ENCRYPTION_KEY=

# Sandbox by default. Switch to the production host when going live.
FLW_BASE_URL=https://developersandbox-api.flutterwave.com

# Email — receipts and the full score analysis. https://resend.com/api-keys
# Without these the receipt page still shows everything; it just can't send mail.
RESEND_API_KEY=
# Must be a domain you've verified with Resend, e.g. "Nepo Detector <receipts@nepodetector.ng>"
EMAIL_FROM=
# Optional: where replies go if it differs from EMAIL_FROM.
EMAIL_REPLY_TO=

# Public origin, used to build absolute og:image URLs for link previews.
# Falls back to the Vercel deployment host, then https://nepodetector.ng.
NEXT_PUBLIC_SITE_URL=

# Optional: powers the AI roast line. Without it, pre-written roasts are used.
GROQ_API_KEY=
